# Salin menjadi .env (lokal) atau isi di dashboard Vercel.
# JANGAN commit file .env. Tidak ada nilai rahasia di repo ini.

# Wajib: string acak panjang. Melindungi /api/tick, /api/kill, /api/export.
CRON_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Wajib di Vercel (state tidak boleh di filesystem). Gratis di upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsional
CAPITAL_IDR=100000000

# Hanya untuk pengembangan lokal (default: data/local-store.json)
# LOCAL_STORE_FILE=data/local-store.json
