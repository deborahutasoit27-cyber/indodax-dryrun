{
  "name": "indodax-dryrun-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot dry run Indodax (UAS Algorithmic Trading) — long-only, tanpa API key",
  "engines": { "node": ">=20" },
  "scripts": {
    "select-universe": "node scripts/select_universe.js",
